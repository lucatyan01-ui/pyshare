# 项目名称
APP_NAME=pyshare

# 运行环境：development / testing / production
APP_ENV=development

# 是否开启调试模式，开发时可以为 true，生产环境应为 false
DEBUG=true

# 服务监听地址
HOST=127.0.0.1

# 服务监听端口
PORT=8000

# 数据库连接地址，默认使用当前项目目录下的 SQLite 文件
DATABASE_URL=sqlite:///./pyshare.sqlite3

# 项目密钥，真实项目里要在 .env 中改成随机复杂字符串
SECRET_KEY=change-me

# 登录令牌过期时间，单位是分钟
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 上传文件保存目录
UPLOAD_DIR=uploads

# 单个上传文件最大体积，单位是 MB
MAX_UPLOAD_SIZE_MB=100
